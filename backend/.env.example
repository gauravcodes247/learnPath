PORT=5000
# Any long random string; keep it secret. Tokens last JWT_EXPIRES_IN.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string (free M0 cluster supports Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnpath?retryWrites=true&w=majority

# Free key from https://aistudio.google.com/apikey
# Leave empty to run fully offline (local embeddings + rule-based study plan).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Recommendation cache lifetime (TTL index), in seconds
RECO_TTL_SECONDS=3600
